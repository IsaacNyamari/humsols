# Copy to .env.local (development) or .env.production.local (server) and fill in.
# Never commit real values.

# --- Database ---------------------------------------------------------------
# MongoDB connection string. In production include the dedicated user, e.g.
# mongodb://humsols:<password>@127.0.0.1:27017/humsols?authSource=humsols
# NOTE: `npm run build` reads published content from this database, so it must
# be reachable at build time as well as at runtime.
MONGODB_URI=mongodb://127.0.0.1:27017/humsols

# --- Auth (Auth.js) -----------------------------------------------------------
# Random 32+ byte secret used to sign session tokens: `npx auth secret` or
# `openssl rand -base64 32`.
AUTH_SECRET=
# Public base URL of the site (used by Auth.js for callbacks).
AUTH_URL=https://humsols.com
# Trust the X-Forwarded-* headers set by nginx.
AUTH_TRUST_HOST=true

# --- Site ---------------------------------------------------------------------
# Canonical URL used in sitemap, Open Graph, emails and admin links.
SITE_URL=https://humsols.com

# --- Email (Nodemailer / SMTP) ------------------------------------------------
# MAIL_DRIVER=smtp sends real mail. MAIL_DRIVER=log prints emails to the server
# log instead (default in development and tests).
MAIL_DRIVER=smtp
SMTP_HOST=mail.humsols.com
SMTP_PORT=465
# true for port 465 (implicit TLS), false for 587 (STARTTLS).
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Human Solutions <info@humsols.com>"
# Fallback lead notification recipients (comma separated). Admin > Settings
# overrides this once saved.
LEAD_NOTIFY_TO=info@humsols.com

# --- Seed (npm run seed) ------------------------------------------------------
# The first owner account. Required by the seed script; never hard-coded.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# --- Uploads ------------------------------------------------------------------
# Where admin uploads are stored on disk (outside /public). Served at /uploads/*.
UPLOAD_DIR=./uploads
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=10

# --- Spam protection ----------------------------------------------------------
# Public form submissions allowed per IP per window (defaults: 5 per 10 minutes).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10

# --- Analytics (optional) -----------------------------------------------------
# Leave empty to disable. When set (e.g. a self-hosted Plausible/Umami script
# URL), the script loads only after the visitor accepts the consent banner.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Admin deploy pipeline (production server only) ---------------------------
# true shows working "Check for updates" / "Deploy" buttons in Admin › Deploy.
# Requires the server pieces in deploy/server/ (see DEPLOYMENT.md).
DEPLOY_ENABLED=false
DEPLOY_BRANCH=main
DEPLOY_STATE_DIR=/var/www/humsols-data/deploy
